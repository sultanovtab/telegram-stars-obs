{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telegram-stars-obs",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "StreamHub"
      }
    ]
  },
  "exports": {
    "StreamHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "BOT_USERNAME": "ttt_stars_bot",
    "BRAND_NAME": "starchik"
  }
}
